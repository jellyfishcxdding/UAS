#include <stdio.h>

int main () {

    int N,Q;
    scanf("%d %d", &N,&Q);
    int A[N];
    for(int i = 0; i<N; i++){
        scanf("%d", &A[i]);
    }

    for(int j = 0; j<Q; j++){
        int X;
        scanf("%d", &X);
        int left = 0;

        int right = Q-1;
        int myIndex = -1;
        while(left<= right){
            int mid = left + (right-left)/2;
            if(A[mid]== X){
                
                myIndex = mid;
                left = mid + 1;//geser sampe index paling gede
            }
            else if(A[mid] <X){
                left = mid +1;
            }
            else {
                right = mid+1;
            }
        }

        if(myIndex != -1){
            printf("%d\n", myIndex +1);
        }
        else {
            printf("-1\n");
        }
    }



    return 0;
}

